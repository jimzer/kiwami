#!/usr/bin/env bash
# Apply a Kiwami theme.
#
#   kiwami-theme            apply the current theme again (after editing it)
#   kiwami-theme <name>     switch to config/themes/<name>
#
# One palette (colors.json) is the source of truth. Programs that can read it
# themselves do; the rest get a generated file. Everything points at the stable
# path ~/.local/state/kiwami/current/theme, so switching swaps what that IS and
# no application config is ever rewritten.
set -euo pipefail

REPO="${KIWAMI_REPO:-$HOME/kiwami}"
STATE="$HOME/.local/state/kiwami"
CURRENT="$STATE/current/theme"
STAGE="$STATE/current/next-theme"

THEME="${1:-$(cat "$STATE/current/theme.name" 2>/dev/null || echo kiwami)}"
SRC="$REPO/config/themes/$THEME"

[[ -d "$SRC" ]] || { echo "no such theme: $THEME ($SRC)" >&2; exit 1; }
[[ -f "$SRC/colors.json" ]] || { echo "theme $THEME has no colors.json" >&2; exit 1; }

# Build in a staging dir and move it into place, so a half-rendered theme is
# never visible to a running program.
rm -rf "$STAGE"
mkdir -p "$STAGE" "$STATE/current"
cp -r "$SRC/." "$STAGE/"

j() { jq -r ".$1" "$STAGE/colors.json"; }
hex() { j "$1" | sed 's/^#//'; }

# --- Ghostty: included from its config via `config-file` ------------------
{
  echo "# Generated by kiwami-theme from themes/$THEME/colors.json. Do not edit."
  echo "background = $(hex background)"
  echo "foreground = $(hex foreground)"
  echo "cursor-color = $(hex accent)"
  echo "selection-background = $(hex selection)"
  echo "selection-foreground = $(hex foreground)"
  # 0-7 normal, 8-15 bright
  for i in "0 dark_background" "1 red" "2 green" "3 yellow" "4 blue" \
           "5 magenta" "6 cyan" "7 light_foreground" \
           "8 muted" "9 bright_red" "10 bright_green" "11 bright_yellow" \
           "12 bright_blue" "13 bright_magenta" "14 bright_cyan" "15 foreground"; do
    set -- $i
    echo "palette = $1=#$(hex "$2")"
  done
} > "$STAGE/ghostty.conf"

# --- Hyprland: dofile'd from hyprland.lua ---------------------------------
{
  echo "-- Generated by kiwami-theme from themes/$THEME/colors.json. Do not edit."
  echo "return {"
  jq -r 'to_entries[] | select(.value | startswith("#")) |
         "  [\"\(.key)\"] = \"\(.value | ltrimstr("#"))\","' "$STAGE/colors.json"
  echo "}"
} > "$STAGE/colors.lua"

# Quickshell needs nothing generated: it reads colors.json directly and
# watches it, so the shell retints without a restart.

# Publish with rsync, not by swapping the directory. rsync writes each file to
# a temp name and renames it into place, so no consumer ever sees the file
# missing. Replacing the directory instead leaves a window in which
# `rm -rf` has removed it, and a watcher that reads during that window gets
# "File does not exist" and stops watching - the shell then never retints.
mkdir -p "$CURRENT"
rsync -a --delete "$STAGE/" "$CURRENT/"
rm -rf "$STAGE"
echo "$THEME" > "$STATE/current/theme.name"

# --- retint running programs ---------------------------------------------
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || systemctl --user show-environment 2>/dev/null | grep -q HYPRLAND_INSTANCE_SIGNATURE; then
  export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(
    systemctl --user show-environment | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')}"
  hyprctl reload >/dev/null 2>&1 || true
fi
# Ghostty re-reads its config on SIGUSR2.
pkill -USR2 -x ghostty 2>/dev/null || true

echo "theme: $THEME"
