# Kiwami Ghostty configuration.
#
# Edit this file in the flake and rebuild. Colours are not here: they come
# from the active theme, which `kiwami theme set` regenerates without a
# rebuild. The `?` makes the include optional so a machine with no theme
# applied still starts.
config-file = ?~/.local/state/kiwami/current/theme/ghostty.conf

font-family = JetBrainsMono Nerd Font
font-size = 11

window-padding-x = 10
window-padding-y = 8
window-decoration = false

cursor-style = block
confirm-close-surface = false

# Keep the scrollback useful for reading build output.
scrollback-limit = 100000
