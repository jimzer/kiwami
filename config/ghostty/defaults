# Kiwami's Ghostty defaults.
#
# A real Ghostty config file, shipped read-only to /etc via Nix, exactly like
# the Hyprland Lua. Override any of it without editing this file:
#   - per machine, declaratively:  kiwami.terminal.settings.font-size = 14;
#   - per user, instantly:         ~/.config/ghostty/overrides
# Both are included after this one, and Ghostty lets the last include win.

font-family = JetBrainsMono Nerd Font
font-size = 11

window-padding-x = 10
window-padding-y = 8
window-decoration = false

cursor-style = block
confirm-close-surface = false

# Keep the scrollback useful for reading build output.
scrollback-limit = 100000
